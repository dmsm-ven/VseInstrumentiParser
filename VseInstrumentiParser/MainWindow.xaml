<Window
    x:Class="VseInstrumentiParser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VseInstrumentiParser"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    Closing="Window_Closing"
    Loaded="Window_Loaded"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <ListBox
            x:Name="lbLogs"
            Grid.Column="1"
            Margin="2"
            Background="Black"
            Foreground="Yellow" />
        <StackPanel
            Grid.Column="0"
            Margin="4"
            HorizontalAlignment="Center"
            Orientation="Vertical">

            <Button
                x:Name="btnParseFromHtml"
                Margin="4"
                Click="btnParseFromHtml_Click"
                Content="Загрузить изображения из HTML" />
            <Button
                x:Name="btnSeleniumOpen"
                Margin="4"
                Click="btnSeleniumOpen_Click"
                Content="Открыть браузер"
                Visibility="Collapsed" />
            <Button
                x:Name="btnSeleniumSearch"
                Margin="4"
                Click="btnSeleniumSearch_Click"
                Content="Поиск с использованием Selenium"
                Visibility="Collapsed" />

            <TextBlock Margin="4" Text="Модель" />
            <TextBox x:Name="txtModelName" Margin="4" />

            <TextBox
                x:Name="txtDescription"
                Height="80"
                Margin="4"
                d:Text="Описание ....."
                Foreground="DarkGray"
                IsReadOnly="True"
                VerticalScrollBarVisibility="Auto" />
            <CheckBox
                Name="btnGenerateSql"
                Margin="4"
                Content="Генерировать SQL"
                IsChecked="True" />

            <CheckBox
                Name="chkResizeImages"
                Margin="4"
                Content="Изменить размер скаченных изображений"
                IsChecked="True" />

            <CheckBox
                Name="btnUploadToFtp"
                Margin="4"
                Content="Выгружать картинки на FTP"
                IsChecked="True" />
            <CheckBox
                Name="chkAutoRunSql"
                Margin="4"
                Content="Автоматически запускать SQL-запросы"
                IsChecked="True" />
            <CheckBox
                Name="chkPlayBeep"
                Margin="4"
                Content="Проигрывать звуковой сигнал"
                IsChecked="True" />
            <TextBlock Margin="4" Text="Путь до папки с изображениями бренда" />
            <TextBox
                x:Name="txtImageManufacturerPath"
                Margin="4"
                Text="catalog/stayer/products" />

        </StackPanel>
    </Grid>
</Window>
